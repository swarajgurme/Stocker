# ============================================
# Stocker Enterprise AI Platform
# Environment Configuration
# ============================================

# --------------------------------------------
# Database migrations (Alembic)
# --------------------------------------------
# Set to true only for lightweight tests / SQLite quirks
# SKIP_ALEMBIC=false

# --------------------------------------------
# Flask Core
# --------------------------------------------
FLASK_ENV=development
FLASK_DEBUG=True
FLASK_PORT=5000
FLASK_HOST=0.0.0.0
SECRET_KEY=dev-secret-key-change-for-production

# --------------------------------------------
# Database
# --------------------------------------------
# PostgreSQL connection string
# Format: postgresql+psycopg2://USER:PASS@HOST:PORT/DB
DATABASE_URL=postgresql+psycopg2://swarajgurme:@localhost:5432/stocker_db

# Connection pool settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# --------------------------------------------
# JWT Authentication
# --------------------------------------------
JWT_SECRET_KEY=jwt-secret-key-change-in-production
JWT_ACCESS_TOKEN_HOURS=24
JWT_REFRESH_TOKEN_DAYS=30

# Bootstrap admin (development / compose). Required for scripts/init_db.py
STOCKER_BOOTSTRAP_ADMIN_EMAIL=admin@stocker.com
STOCKER_BOOTSTRAP_ADMIN_PASSWORD=

# Optional: sales CSV for migrate_csv_to_db (filename under backend/ or absolute path).
# Default: data.csv. Real UCI extract: run backend/scripts/fetch_uci_online_retail_csv.py
# then point here, e.g. STOCKER_CSV_PATH=data_uci_online_retail.csv
# STOCKER_CSV_PATH=data.csv

# --------------------------------------------
# CORS (Cross-Origin Resource Sharing)
# --------------------------------------------
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8080

# --------------------------------------------
# Rate Limiting
# --------------------------------------------
RATELIMIT_ENABLED=False
RATELIMIT_DEFAULT=100/hour
# Use memory:// for single instance, or redis://host:6379/0 for production clusters
RATELIMIT_STORAGE_URL=memory://

# --------------------------------------------
# Redis (Caching & Celery)
# --------------------------------------------
REDIS_URL=redis://localhost:6379/0
# When REDIS_URL is set and reachable, JWT logout denylist is stored in Redis (TTL = token expiry)
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# --------------------------------------------
# Logging
# --------------------------------------------
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# --------------------------------------------
# Machine Learning / Forecasting
# --------------------------------------------
FORECAST_HORIZON_DAYS=365
CONFIDENCE_INTERVAL=0.95
AUTO_RETRAIN_DAYS=7
MIN_HISTORICAL_DATA_POINTS=30

# --------------------------------------------
# Data Validation Limits
# --------------------------------------------
MAX_DATE_RANGE_DAYS=730
REQUEST_TIMEOUT_SECONDS=30

# --------------------------------------------
# External Integrations (Optional)
# --------------------------------------------
# SMTP (Email alerts)
# SMTP_SERVER=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=your-email@gmail.com
# SMTP_PASSWORD=your-app-password

# AWS (S3 for reports, CloudWatch)
# AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
# AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
# AWS_REGION=us-east-1
# S3_BUCKET=stocker-reports
